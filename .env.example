# Copy to .env and adjust. Never commit .env.

# --- Database -----------------------------------------------------------
POSTGRES_USER=clauseguard
POSTGRES_PASSWORD=clauseguard
POSTGRES_DB=clauseguard
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Port the database is published on to the host. 5433 rather than 5432 so the
# stack does not clash with another PostgreSQL already running on this machine.
POSTGRES_HOST_PORT=5433

# Full SQLAlchemy URL. Overrides the POSTGRES_* parts above if set.
# Leave blank for host runs (pytest, alembic) and the POSTGRES_* values apply.
# Inside Docker, docker-compose.yml sets this to the db:5432 service address.
DATABASE_URL=

# --- Application --------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# Secret used to sign JWTs (Phase 5). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-change-me

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Limits (SRS Appendix C, resolved in PLAN.md 7) ---------------------
MAX_UPLOAD_MB=10
MIN_CONFIDENCE_THRESHOLD=0.45
MAX_CONCURRENT_ANALYSES=5

# --- Versions recorded on every report (SRS 5.5) ------------------------
ACTIVE_RUBRIC_VERSION=1.0
ACTIVE_MODEL_VERSION=not-trained-yet
